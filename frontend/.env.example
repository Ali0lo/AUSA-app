# =============================================================
# AUSA Platform Frontend Environment Configuration Template
# Copy this file to '.env.local' and populate with target URLs.
# =============================================================

# Server-side backend URL used by the Next.js proxy. In production set this to
# the deployed FastAPI URL; localhost is only for local development.
AUSA_API_URL=http://localhost:8000/api/v1

# Optional direct browser URL. Leave unset to use the same-origin proxy above.
NEXT_PUBLIC_API_URL=

# NextAuth Authentication Configuration
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=YOUR_NEXTAUTH_SECRET_32_BYTE_RANDOM_STRING_HERE

# Google OAuth Credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
