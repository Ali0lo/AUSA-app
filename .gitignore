# Environment & secret files
.env
.env.local
.env.production
.env.staging
*.env

# Python & Virtual Environments
.venv/
venv/
__pycache__/
*.py[cod]
*.so

# Node & Next.js Build Outputs
node_modules/
.next/
out/
build/
dist/

# Logs & Databases
*.log
*.sqlite3
*.db
local_pgdata/

# OS & Editor Files
.DS_Store
.vscode/
.idea/
*.swp

# Collected datasets (~700 MB). Reproduce with backend/scripts/collect_*.py, see
# data/README.md. Scoped to data/** so these patterns never swallow source files
# elsewhere, and without them `git add -A` after a collection run commits the raw
# College Scorecard archive.
data/raw/*
!data/raw/.gitkeep
data/processed/*
!data/processed/.gitkeep
data/**/*.csv
data/**/*.json
data/**/*.zip
data/**/*.pdf
data/**/*.xlsx
data/raw/turkey/
data/raw/usa/
!data/**/.gitkeep

# Curated requirement rows are the exception: hand-written by a person from an official
# page, small, and not reproducible by any script. Losing one means someone reads a
# university's admissions page again. These belong in git.
!data/curation/*.csv

# The three inputs `docker compose up` cannot run without, 878 KB in total. Without
# them a fresh clone gets an empty dp_catalogue and an Azerbaijan section that reports
# itself absent, which is exactly what happened before the compose stack existed:
# bootstrap_catalogue reads these files, it does not fetch them.
#
# They stay reproducible -- collect_dp_catalogue.py re-downloads the DP files from the
# open-data portal and collect_azerbaijan.py rebuilds the history -- so committing them
# pins a known-good copy rather than replacing the collection path.
#
# `data/raw/*` above excludes the azerbaijan DIRECTORY, and git never looks inside an
# excluded directory, so a file exception under it cannot match until the directory
# itself is re-included. Re-including it then needs its own contents re-excluded, or
# the next collection run commits everything that lands there.
!data/raw/azerbaijan/
data/raw/azerbaijan/*
!data/raw/azerbaijan/dp-bakalavr-2026.csv
!data/raw/azerbaijan/dp-master-2026.csv
!data/processed/azerbaijan_cutoff_history.csv

# Trained model artifacts -- regenerate with train_cutoff_models.py.
# models/metrics.json IS committed: ADR-0004 requires every predicted_cutoff to be
# traceable to the exact run that produced it.
models/*.joblib
!models/metrics.json

# Model artifacts & vector stores
*.pkl
*.faiss
*.chroma

# CatBoost training logs
catboost_info/

# Playwright MCP page snapshots, written when inspecting a site's network calls.
.playwright-mcp/

# Streamlit
.streamlit/secrets.toml

# Next.js generated files
next-env.d.ts
*.tsbuildinfo

# Subagent-driven-development scratch: ledgers, briefs, reports, review packages.
# Git history is the durable record; this is the coordination trail while a plan runs.
.superpowers/
