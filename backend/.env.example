# =============================================================
# AUSA Platform Backend Environment Configuration Template
# Copy this file to '.env' and populate with production secrets.
# =============================================================

# Server Environment & Logging
ENVIRONMENT=production
LOG_LEVEL=info

# Database Connection (Async SQLAlchemy with asyncpg driver)
DATABASE_URL=postgresql+asyncpg://ausa_user:YOUR_POSTGRES_PASSWORD_HERE@localhost:5432/ausa_db

# PostgreSQL Container Credentials (used by docker-compose.prod.yml)
POSTGRES_USER=ausa_user
POSTGRES_PASSWORD=YOUR_POSTGRES_PASSWORD_HERE
POSTGRES_DB=ausa_db
POSTGRES_PORT=5432

# Security & JWT Token Signing
SECRET_KEY=YOUR_SUPER_SECRET_JWT_32_BYTE_STRING_KEY_HERE
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# OpenAI API Key (Required for RAG embeddings and LLM extraction)
OPENAI_API_KEY=sk-proj-YOUR_OPENAI_API_KEY_HERE

# CORS Origin Whitelist (comma-separated origins)
CORS_ORIGINS=http://localhost:3000,https://ausa.edu.az

